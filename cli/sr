#!/bin/bash
# sr — Spaces Renamer CLI
# Thin wrapper around the spacesrenamer:// URL scheme.
# Symlinked to ~/.local/bin/sr by the app on launch.
set -euo pipefail

CMD="${1:-help}"
RESPONSE_DIR=""
RESPONSE_FILE=""

cleanup_response() {
  if [[ -n "$RESPONSE_FILE" ]]; then
    rm -f -- "$RESPONSE_FILE"
  fi
  if [[ -n "$RESPONSE_DIR" ]]; then
    rmdir -- "$RESPONSE_DIR" 2>/dev/null || true
  fi
}

trap cleanup_response EXIT

url_encode() {
  local input="$1" output="" char hex byte i LC_ALL=C
  for ((i = 0; i < ${#input}; i++)); do
    char="${input:i:1}"
    case "$char" in
      [a-zA-Z0-9.~_-]) output+="$char" ;;
      *)
        printf -v byte '%d' "'$char"
        if ((byte < 0)); then
          byte=$((byte + 256))
        fi
        printf -v hex '%02X' "$byte"
        output+="%$hex"
        ;;
    esac
  done
  printf '%s' "$output"
}

open_url() {
  open "spacesrenamer://$1"
}

request_json() {
  local endpoint="$1" attempts
  RESPONSE_DIR="$(mktemp -d "/tmp/spaces-renamer-cli-${UID}.XXXXXX")"
  RESPONSE_FILE="$RESPONSE_DIR/response.json"

  open_url "$endpoint?reply=$(url_encode "$RESPONSE_FILE")"

  for ((attempts = 0; attempts < 100; attempts++)); do
    if [[ -s "$RESPONSE_FILE" ]]; then
      cat "$RESPONSE_FILE"
      return 0
    fi
    sleep 0.1
  done

  echo "Spaces Renamer did not return a response. Is the app able to open?" >&2
  return 1
}

case "$CMD" in
  status)
    request_json "status"
    ;;
  renamer)
    open_url "renamer"
    ;;
  settings)
    open_url "settings"
    ;;
  profile)
    SUB="${2:-}"
    case "$SUB" in
      switch)
        open_url "profile/switch/${3:-}"
        ;;
      list)
        request_json "profile/list"
        ;;
      *)
        echo "Usage: sr profile switch <uuid> | sr profile list" >&2
        exit 1
        ;;
    esac
    ;;
  naming)
    MODE="${2:-}"
    case "$MODE" in
      manual|applications|yabaiLabels)
        open_url "naming/${MODE}"
        ;;
      *)
        echo "Usage: sr naming manual|applications|yabaiLabels" >&2
        exit 1
        ;;
    esac
    ;;
  space)
    SPACE_UUID="${2:-}"
    SUB="${3:-}"
    case "$SUB" in
      name)
        shift 3
        NAME="$*"
        if [[ -z "$NAME" ]]; then
          echo "Usage: sr space <uuid> name <name>" >&2
          exit 1
        fi
        ENCODED="$(url_encode "$NAME")"
        open_url "space/${SPACE_UUID}/name?name=${ENCODED}"
        ;;
      *)
        echo "Usage: sr space <uuid> name <name>" >&2
        exit 1
        ;;
    esac
    ;;
  help|--help|-h)
    echo "Spaces Renamer CLI"
    echo ""
    echo "Usage:"
    echo "  sr status                  Show current state"
    echo "  sr renamer                 Open rename popover"
    echo "  sr settings                Open settings"
    echo "  sr profile switch <uuid>   Switch active profile"
    echo "  sr profile list            List profiles as JSON"
    echo "  sr naming <mode>           Set naming mode (manual|applications|yabaiLabels)"
    echo "  sr space <uuid> name <n>  Set space name"
    echo "  sr help                    Show this help"
    ;;
  *)
    echo "Unknown command: $CMD" >&2
    echo "Run 'sr help' for usage." >&2
    exit 1
    ;;
esac
